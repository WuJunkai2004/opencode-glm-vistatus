{
  "name": "opencode-glm-vistatus",
  "version": "1.2.0",
  "description": "OpenCode TUI plugin displaying real-time GLM Coding Plan quota usage in the sidebar",
  "author": "Wu Junkai <wu.junkai@qq.com>",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "config": {
        "enabled": true
      }
    }
  },
  "files": [
    "dist",
    "src",
    "install.mjs",
    "VERSION.txt",
    "README.md",
    "README.en.md"
  ],
  "bin": {
    "opencode-glm-vistatus": "install.mjs"
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "build:tui": "node build.tui.mjs",
    "typecheck": "tsc --noEmit",
    "sync-version": "node scripts/sync-version.mjs",
    "inspect": "node scripts/inspect.mjs",
    "version": "node -e \"require('fs').writeFileSync('src/_version.ts','// auto-generated\\nexport const PLUGIN_VERSION='+JSON.stringify(require('./package.json').version)+';\\n')\"",
    "prepublishOnly": "npm run sync-version && npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "glm",
    "zhipu",
    "zai",
    "quota",
    "coding-plan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuJunkai2004/opencode-glm-vistatus.git"
  },
  "bugs": {
    "url": "https://github.com/WuJunkai2004/opencode-glm-vistatus/issues"
  },
  "homepage": "https://github.com/WuJunkai2004/opencode-glm-vistatus#readme",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0",
    "@opentui/solid": ">=0.2.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.50",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "babel-plugin-module-resolver": "^5.0.3",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.0.3",
    "glob": "^11.0.0"
  }
}
