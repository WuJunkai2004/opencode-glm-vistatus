{
  "name": "opencode-glm-vistatus",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin displaying real-time GLM Coding Plan quota usage in the sidebar",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "config": {
        "enabled": true
      }
    }
  },
  "files": [
    "dist",
    "src",
    "install.mjs",
    "README.md"
  ],
  "bin": {
    "opencode-glm-vistatus": "install.mjs"
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "build:tui": "node build.tui.mjs",
    "typecheck": "tsc --noEmit",
    "version": "node -e \"require('fs').writeFileSync('src/_version.ts','// auto-generated\\nexport const PLUGIN_VERSION='+JSON.stringify(require('./package.json').version)+';\\n')\"",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "glm",
    "zhipu",
    "zai",
    "quota",
    "coding-plan"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0",
    "@opencode-ai/sdk": ">=1.14.0",
    "@opentui/core": ">=0.2.0",
    "@opentui/solid": "^0.1.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.3",
    "@opencode-ai/sdk": "^1.14.50",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "typescript": "^5.8.0"
  }
}
